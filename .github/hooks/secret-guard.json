{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "create|edit",
        "command": "node .github/hooks/secret-guard.js",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "matcher": "bash|powershell",
        "command": "node .github/hooks/secret-guard.js",
        "timeoutSec": 15
      }
    ]
  }
}
